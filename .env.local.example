NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Уведомления о нехватке склада в Telegram (см. README → "Уведомления в Telegram")
TELEGRAM_BOT_TOKEN=YOUR-BOT-TOKEN
TELEGRAM_CHAT_ID=YOUR-CHAT-ID
STOCK_ALERT_WEBHOOK_SECRET=YOUR-RANDOM-SECRET

# Интерактивный Telegram-бот для кладовщика (см. README → "Telegram-бот для кладовщика")
TELEGRAM_KLADOVSHIK_PIN=YOUR-4-DIGIT-PIN
TELEGRAM_WEBHOOK_SECRET=YOUR-RANDOM-SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
# Часовой пояс для дат в /history_orders (по умолчанию Asia/Tashkent)
TELEGRAM_TIMEZONE=Asia/Tashkent

# Ежедневный итог в Telegram (см. README → "Ежедневный итог"): секрет, с которым планировщик вызывает /api/cron/daily-summary
CRON_SECRET=YOUR-LONG-RANDOM-SECRET

# Бот для работников цеха (см. README → "Бот для работников цеха (Этап 2)").
# Отдельный бот со своим токеном от @BotFather — НЕ токен первого бота.
TELEGRAM_WORKER_BOT_TOKEN=YOUR-WORKER-BOT-TOKEN
# Секрет вебхука: openssl rand -hex 32
TELEGRAM_WORKER_WEBHOOK_SECRET=YOUR-RANDOM-SECRET
# Имя бота без @ (для ссылок-приглашений https://t.me/<имя>?start=…)
TELEGRAM_WORKER_BOT_USERNAME=your_workers_bot
